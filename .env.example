# SMTP configuration for contact form emails.
# All SMTP_* variables are required to enable email sending.
# If not set, the contact form still works but no emails are sent.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=noreply@yourdomain.com
CONTACT_EMAIL=you@gmail.com

# Set to "true" only when running behind a trusted reverse proxy (nginx, Cloudflare, etc.)
# that sets X-Forwarded-For / X-Real-IP headers. Leave unset or "false" otherwise.
TRUST_PROXY=false

# Admin panel password. Set this to enable /admin login.
# If not set, the admin panel login will be disabled.
ADMIN_PASSWORD=your-secure-password-here
